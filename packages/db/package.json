{
  "name": "@dsp/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "embed": "node scripts/embed-migrations.ts",
    "check:migrations": "node scripts/embed-migrations.ts --check",
    "generate": "drizzle-kit generate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "pnpm run check:migrations && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@dsp/domain": "workspace:*",
    "@electric-sql/pglite": "0.5.12",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "drizzle-kit": "0.31.11"
  }
}
