{
  "name": "@dsp/seed",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "pnpm run check:data && pnpm run typecheck && pnpm run test",
    "generate": "node scripts/generate-json.ts",
    "check:data": "node scripts/generate-json.ts --check"
  },
  "dependencies": {
    "@dsp/db": "workspace:*",
    "@dsp/domain": "workspace:*",
    "@electric-sql/pglite": "0.5.12",
    "@faker-js/faker": "10.6.0"
  },
  "devDependencies": {
    "@dsp/contract": "workspace:*",
    "@types/node": "24.10.1"
  }
}
