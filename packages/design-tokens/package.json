{
  "name": "@index/design-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./generated/tokens.css",
    "./fonts.css": "./generated/fonts.css",
    "./tokens.json": "./generated/tokens.json",
    "./comparison/palette-v1.0.css": "./generated/comparison/palette-v1.0.css",
    "./comparison/palette-muted-graphite.css": "./generated/comparison/palette-muted-graphite.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "generate": "node scripts/generate.ts",
    "fonts": "node scripts/fonts.ts",
    "check:generated": "node scripts/generate.ts --check",
    "check:fonts": "node scripts/fonts.ts --check",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "pnpm run typecheck && pnpm run check:fonts && pnpm run check:generated && pnpm run test",
    "preview": "node scripts/preview.ts"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@types/node": "24.10.1"
  }
}
