{
  "name": "@dsp/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json && node scripts/serve.ts --build && node scripts/check-offline.ts",
    "check": "pnpm run typecheck && pnpm run test",
    "dev": "node scripts/serve.ts",
    "test": "tsc -p tsconfig.test.json && node --test \"dist/test-build/tests/**/*.test.js\"",
    "check:offline": "node scripts/check-offline.ts"
  },
  "dependencies": {
    "@dsp/api": "workspace:*",
    "@dsp/contract": "workspace:*",
    "@dsp/db": "workspace:*",
    "@dsp/domain": "workspace:*",
    "@dsp/seed": "workspace:*",
    "@electric-sql/pglite": "0.5.12",
    "@hookform/resolvers": "6.0.2",
    "@index/design-tokens": "workspace:*",
    "@index/ui": "workspace:*",
    "@index/ui-patterns": "workspace:*",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3"
  }
}
