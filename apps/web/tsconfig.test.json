{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist/test-build",
    "declaration": false,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["src/lib/**/*.ts", "src/api/**/*.ts", "src/api/**/*.tsx", "src/components/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"]
}
